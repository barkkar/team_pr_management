{
  "name": "team_pr_management",
  "version": "1.0.0",
  "description": "Slack app to monitor PR review status and send reminders",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "dev": "ts-node src/index.ts",
    "check-reminders": "node dist/scripts/checkReminders.js",
    "migrate": "ts-node src/db/migrate.ts",
    "postinstall": "npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
