# Slack App Credentials
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token

# GitHub Enterprise Configuration
GHE_TOKEN=your-github-enterprise-personal-access-token
# Note: GHE_BASE_URL is no longer needed - hostname is extracted from PR URLs

# Database (auto-set by Heroku Postgres)
DATABASE_URL=postgres://localhost:5432/pr_reminders

# Timezone
TZ=America/Los_Angeles

# Worker API (for local VPN worker)
# Generate a secure random key: openssl rand -hex 32
WORKER_API_KEY=your-secure-api-key

# For local worker only (not needed on Heroku)
HEROKU_API_URL=https://your-app-name.herokuapp.com
