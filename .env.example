# Slack App Credentials
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token

# GitHub Enterprise Configuration
# Option 1: Single token (used as fallback for all hostnames)
GHE_TOKEN=your-github-enterprise-personal-access-token
# Option 2: Per-hostname tokens (JSON map, preferred for multiple GHE instances)
# GHE_TOKENS={"gitcore.soma.salesforce.com":"token-for-gitcore","git.soma.salesforce.com":"token-for-git"}
# Note: If GHE_TOKENS is set, it takes priority. GHE_TOKEN is used as fallback for unlisted hosts.

# Database (auto-set by Heroku Postgres)
DATABASE_URL=postgres://localhost:5432/pr_reminders

# Timezone
TZ=America/Los_Angeles

# Worker API (for local VPN worker)
# Generate a secure random key: openssl rand -hex 32
WORKER_API_KEY=your-secure-api-key

# For local worker only (not needed on Heroku)
HEROKU_API_URL=https://your-app-name.herokuapp.com

# Channel Access Control (REQUIRED)
# Comma-separated list of Slack channel IDs the bot is allowed to read history from.
# This enforces code-level controls for groups:history (private channels) and
# channels:history (public channels) scopes. The bot will refuse to start without this.
# Example: ALLOWED_CHANNEL_IDS=C0123ABC456,G0789DEF012
ALLOWED_CHANNEL_IDS=

# Error Notifications
# Slack channel ID where worker/job errors are posted (optional).
# If unset, errors are only logged to console.
ERROR_SLACK_CHANNEL_ID=

# Claude AI (for LLM chat/generation)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
CLAUDE_MODEL=claude-sonnet-4-20250514

# Ollama Configuration (for embeddings only)
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
